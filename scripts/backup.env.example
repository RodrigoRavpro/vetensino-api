# This file is copied to /root/vetensino/.backup.env and must be chmod 600.
# AWS authentication comes from the root user's AWS profile or instance role.
VETENSINO_ENV_FILE=/root/vetensino/.env
NPM_ENV_FILE=/root/purple-vet-proxy-manager/.env
BACKUP_DIR=/root/vetensino/backups
BACKUP_LOCK_FILE=/var/lock/vetensino-backup.lock

VETENSINO_DB_CONTAINER=vetensino-db
NPM_DB_CONTAINER=npm-db
NPM_DATA_VOLUME=purple-vet-proxy-manager_npm_data
NPM_LETSENCRYPT_VOLUME=purple-vet-proxy-manager_npm_letsencrypt

LOCAL_RETENTION_DAYS=7
S3_BUCKET=ravpro-main
S3_PREFIX=backup_db/vetensino
S3_RETENTION_DAYS=30
AWS_REGION=sa-east-1

# Leave empty to reuse MYSQL_ROOT_PASSWORD from NPM_ENV_FILE.
NPM_DB_ROOT_PASSWORD=